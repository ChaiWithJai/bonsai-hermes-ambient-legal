{
  "model": {
    "default": "bonsai-ui-public-ternary-bonsai2",
    "provider": "custom",
    "base_url": "http://127.0.0.1:5262/v1",
    "api_key": "local",
    "api_mode": "chat_completions",
    "streaming": false,
    "context_length": 65536
  },
  "agent": {"max_turns": 12, "reasoning_effort": "medium"},
  "platform_toolsets": {"cli": ["ambient_legal"], "cron": ["ambient_legal"], "slack": ["ambient_legal"]},
  "mcp_servers": {
    "ambient_legal": {
      "command": "python3",
      "args": ["REPLACE_WITH_ABSOLUTE_PATH/ambient.py", "mcp"],
      "tools": {"resources": false, "prompts": false},
      "timeout": 30
    }
  },
  "memory": {"memory_enabled": false, "user_profile_enabled": false},
  "tools": {"tool_search": {"enabled": "off"}}
}
